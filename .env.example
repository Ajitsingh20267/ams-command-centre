# A.M.S. Command Centre — environment. Copy to .env for local dev; on Render
# (or your host of choice) set these as environment variables instead — never
# commit a real .env.

# ---- Supabase (free tier) ------------------------------------------------
# Create a project at supabase.com (free). Then:
#   DATABASE_URL        Project Settings -> Database -> Connection string (URI, "Session" mode)
#   SUPABASE_URL         Project Settings -> API -> Project URL
#   SUPABASE_ANON_KEY     Project Settings -> API -> anon public key
#   SUPABASE_JWT_SECRET   Project Settings -> API -> JWT Settings -> JWT Secret
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ---- App secrets ----------------------------------------------------------
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=
CRON_SECRET=

# ---- Anthropic (drafting + reply classification) --------------------------
# console.anthropic.com — a separate bill from a Claude subscription, scales
# with volume. Leave blank and the dashboard will show CONNECTION REQUIRED;
# every other part of the app still runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Microsoft Graph (Outlook drafts) — optional until connected ----------
# Azure portal -> App registrations -> New registration -> API permissions ->
# add the APPLICATION permission Mail.ReadWrite -> grant admin consent ->
# Certificates & secrets -> new client secret.
# Do NOT add Mail.Send. See app/agents/graph_client.py.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=invest@amscapital.co.uk

PORT=8080
# Set to "local" only for development over http://localhost — it relaxes the
# session cookie's Secure flag, which every real deployment must keep on.
ENV=production
